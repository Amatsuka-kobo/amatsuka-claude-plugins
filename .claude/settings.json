{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "claude-fable-5[1m]"
  },
  "permissions": {
    "allow": [
      "Bash(node *)",
      "Bash(python3 -c ' *)",
      "Bash(git commit *)",
      "Bash(git pull *)",
      "Bash(git branch *)",
      "Bash(git checkout *)"
    ],
    "deny": [
      "Bash(rm -rf ./)",
      "Bash(rm -rf /)",
      "Bash(git push --force *)",
      "Bash(sudo *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git * main)",
      "Bash(rm *)"
    ]
  },
  "model": "claude-opus-5[1m]",
  "enabledPlugins": {
    "optimize-agents@amatsuka-claude-plugins": true,
    "pitcrew@amatsuka-claude-plugins": true,
    "prefetch@amatsuka-claude-plugins": true,
    "raphael@amatsuka-claude-plugins": true,
    "task-utility@amatsuka-claude-plugins": true,
    "claude-code-setup@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "claude-security@claude-plugins-official": true,
    "explanatory-output-style@claude-plugins-official": true,
    "mcp-server-dev@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "serena@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "pyright@claude-code-lsps": true,
    "mdbase-lsp@claude-code-lsps": true,
    "vtsls@claude-code-lsps": true,
    "bash-language-server@claude-code-lsps": true,
    "codex@openai-codex": true,
    "frontend-design@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "amatsuka-claude-plugins": {
      "source": {
        "source": "directory",
        "path": "./"
      }
    },
    "claude-code-lsps": {
      "source": {
        "source": "git",
        "url": "https://github.com/Piebald-AI/claude-code-lsps.git"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "outputStyle": "EnhancedClaude5"
}
