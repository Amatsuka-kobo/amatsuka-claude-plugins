{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(node *)",
      "Bash(python3 -c ' *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git pull *)",
      "Bash(git branch*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git status*)",
      "Bash(pnpm install*)",
      "Bash(pnpm build*)",
      "Bash(pnpm test*)",
      "Bash(pnpm lint*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm dlx *)",
      "Bash(mkdir -p *)"
    ],
    "deny": [
      "Bash(rm -rf ./)",
      "Bash(rm -rf /)",
      "Bash(git push --force *)",
      "Bash(sudo *)"
    ],
    "ask": [
      "Bash(git checkout *)",
      "Bash(git push *)",
      "Bash(rm *)"
    ]
  },
  "model": "claude-opus-5[1m]",
  "effortLevel": "xhigh",
  "enabledPlugins": {
    "agent-policy@amatsuka-claude-plugins": true,
    "chat-history@amatsuka-claude-plugins": true,
    "prompt-smith@amatsuka-claude-plugins": true,
    "raphael@amatsuka-claude-plugins": true,
    "context7@context7-marketplace": true,
    "claude-security@claude-plugins-official": true,
    "explanatory-output-style@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "genshijin@genshijin": true,
    "codiel@amatsuka-claude-plugins": true,
    "gh-utility@amatsuka-claude-plugins": true,
    "metatron@amatsuka-claude-plugins": true,
    "sandalphon@amatsuka-claude-plugins": true
  },
  "extraKnownMarketplaces": {
    "amatsuka-claude-plugins": {
      "source": {
        "source": "directory",
        "path": "./"
      }
    },
    "context7-marketplace": {
      "source": {
        "source": "github",
        "repo": "upstash/context7"
      }
    },
    "genshijin": {
      "source": {
        "source": "github",
        "repo": "InterfaceX-co-jp/genshijin"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "outputStyle": "EnhancedClaude5",
  "env": {
    "CLAUDE_CODE_THRIFTY_SONIC": "false"
  }
}
