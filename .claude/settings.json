{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "claude-fable-5[1m]",
    "GENSHIJIN_DEFAULT_MODE": "extreme"
  },
  "permissions": {
    "allow": [
      "Bash(node *)",
      "Bash(python3 -c ' *)",
      "Bash(git commit *)",
      "Bash(git pull *)",
      "Bash(git branch *)",
      "Bash(git push *)"
    ],
    "deny": [
      "Bash(rm -rf ./)",
      "Bash(rm -rf /)",
      "Bash(git push --force *)",
      "Bash(sudo *)"
    ],
    "ask": [
      "Bash(git checkout *)",
      "Bash(rm *)"
    ]
  },
  "model": "claude-opus-5[1m]",
  "enabledPlugins": {
    "agent-policy@amatsuka-claude-plugins": true,
    "chat-history@amatsuka-claude-plugins": true,
    "prompt-smith@amatsuka-claude-plugins": true,
    "raphael@amatsuka-claude-plugins": true,
    "context7@context7-marketplace": true,
    "claude-security@claude-plugins-official": true,
    "explanatory-output-style@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "mdbase-lsp@claude-code-lsps": true,
    "genshijin@genshijin": true,
    "codex@openai-codex": true
  },
  "extraKnownMarketplaces": {
    "amatsuka-claude-plugins": {
      "source": {
        "source": "directory",
        "path": "./"
      }
    },
    "claude-code-lsps": {
      "source": {
        "source": "github",
        "repo": "Piebald-AI/claude-code-lsps"
      }
    },
    "context7-marketplace": {
      "source": {
        "source": "github",
        "repo": "upstash/context7"
      }
    },
    "genshijin": {
      "source": {
        "source": "github",
        "repo": "InterfaceX-co-jp/genshijin"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "outputStyle": "EnhancedClaude5"
}
