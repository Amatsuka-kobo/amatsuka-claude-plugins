{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_AUTO_MODE_MODEL": "claude-sonnet-5-5",
    "CLAUDE_CODE_DISABLE_ADVISOR_TOOL": "0",
    "CLAUDE_CODE_THRIFTY_SONIC": "false",
    "GENSHIJIN_DEFAULT_MODE": "normal",
    "PONYTAIL_DEFAULT_MODE": "full"
  },
  "permissions": {
    "allow": [
      "Bash(node *)",
      "Bash(python3 *)",
      "Bash(gh * *list *)",
      "Bash(gh * *view *)",
      "Bash(gh * *status *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr create *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr close *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr close *)",
      "Bash(gh pr reopen *)",
      "Bash(gh pr ready *)",
      "Bash(gh pr merge *)",
      "Bash(gh issue create *)",
      "Bash(gh issue close *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue develop *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue reopen *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git pull *)",
      "Bash(git branch*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git status*)",
      "Bash(git rm *)",
      "Bash(git rm -r *)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(git push *)",
      "Bash(pnpm install*)",
      "Bash(pnpm run build)",
      "Bash(pnpm run test)",
      "Bash(pnpm run lint)",
      "Bash(pnpm run typecheck)",
      "Bash(pnpm dlx *)",
      "Bash(mkdir -p *)",
      "Bash(rm /tmp/**/*)",
      "Workflow",
      "mcp__serena__find_symbol",
      "mcp__serena__read_memory",
      "mcp__serena__list_memories",
      "mcp__serena__get_symbols_overview",
      "mcp__plugin_context7_context7__query-docs",
      "mcp__plugin_context7_context7__resolve-library-id"
    ],
    "deny": [
      "Read(*.env)",
      "Read(.claude/settings.local.json)",
      "Bash(rm -rf ./)",
      "Bash(rm -rf /)",
      "Bash(gh * *delete *)",
      "Bash(gh project copy *)",
      "Bash(gh project *delete *)",
      "Bash(gh project edit *)",
      "Bash(gh repo *)",
      "Bash(git rm -rf *)",
      "Bash(git rm -f *)",
      "Bash(git push --force *)",
      "Bash(sudo *)"
    ]
  },
  "model": "opus",
  "enabledPlugins": {
    "agent-policy@amatsuka-claude-plugins": true,
    "better-agentics@amatsuka-claude-plugins": true,
    "chat-history@amatsuka-claude-plugins": true,
    "prompt-smith@amatsuka-claude-plugins": true,
    "context7@context7-marketplace": true,
    "claude-security@claude-plugins-official": true,
    "explanatory-output-style@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "genshijin@genshijin": true,
    "codiel@amatsuka-claude-plugins": true,
    "gh-utility@amatsuka-claude-plugins": true,
    "metatron@amatsuka-claude-plugins": true,
    "native-japanese@amatsuka-claude-plugins": true,
    "jevriel@amatsuka-claude-plugins": true,
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "amatsuka-claude-plugins": {
      "source": {
        "source": "directory",
        "path": "./"
      },
      "autoUpdate": true
    },
    "context7-marketplace": {
      "source": {
        "source": "github",
        "repo": "upstash/context7"
      }
    },
    "genshijin": {
      "source": {
        "source": "github",
        "repo": "InterfaceX-co-jp/genshijin"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "outputStyle": "EnhancedClaude5",
  "modelSettings": {
    "fable": {
      "effortLevel": "medium"
    },
    "opus": {
      "effortLevel": "medium"
    },
    "sonnet": {
      "effortLevel": "high"
    },
    "haiku": {
      "effortLevel": "medium"
    }
  },
  "advisorModel": "fable"
}
