{
  "description": "agent-policy の運用補助: SessionStart で方針スキルの使用指示・エージェント定義の状態・役割マーカーの対応表を注入し、PreToolUse の delegation gate で保護対象への直接編集を差し止めて委譲を促す(gate は既定で無効。環境変数で有効化する)",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/session-start.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/delegation-gate.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
