{
  "description": "chat スキルの自動適用: docs/chat/ を持つプロジェクトで、未記録のユーザー発言が残ったままターンが終わるとき chat-recorder への記録・追記委譲を促す",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/check-chat-recorded.mjs\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
