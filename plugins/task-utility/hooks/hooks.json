{
  "description": "chat スキルの自動適用: 未記録ターンを検出し、chat-recorder のバックグラウンド記録を促す(ターンはブロックしない)",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/check-chat-recorded.mjs\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
