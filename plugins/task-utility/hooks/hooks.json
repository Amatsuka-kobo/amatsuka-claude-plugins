{
  "description": "chat スキルの自動適用: 未記録ターンをバックグラウンド recorder で記録し、起動不能時のみ chat-recorder への委譲を促す",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/check-chat-recorded.mjs\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
