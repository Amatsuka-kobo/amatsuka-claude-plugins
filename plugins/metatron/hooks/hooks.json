{
  "description": "metatron: SessionStart で ARCHITECTURE/GOTCHAS を注入し、PreToolUse で正本への直接編集を拒否する",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/inject-context.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/guard-docs.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
