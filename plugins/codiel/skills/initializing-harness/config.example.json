{
  "testsDir": "docs/codiel/tests",
  "runsDir": "docs/codiel/runs",
  "raguel": {
    "version": 1,
    "storage": {
      "projectId": "my-service"
    },
    "subject": {
      "ignoreUncommitted": ["docs/chat/**"]
    },
    "rules": {
      "code/protected-paths": {
        "globs": ["src/server/auth/**"],
        "excludeDefaults": [".github/**"],
        "generated": ["dist/**"]
      }
    }
  }
}
